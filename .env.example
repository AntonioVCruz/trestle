# Postgres is the only required infrastructure (ADR 0009).
DATABASE_URL=postgres://trestle:trestle@localhost:5432/trestle

# web role
HOST=0.0.0.0
PORT=9000
LOG_LEVEL=info

# Bootstrap bearer token for the Admin API until real admin auth/RBAC lands.
# If unset, every Admin API request is rejected.
ADMIN_API_TOKEN=change-me

# Registers the "test" payment provider, which moves no money (ADR 0019). For development, CI and
# staging, where end-to-end tests run; never in production. Every role reads it.
ENABLE_TEST_PAYMENT_PROVIDER=true

# Reference storefront (apps/storefront, ADR 0020). It reaches the platform only through the Store
# API. `npm run seed` creates a demo channel and prints a publishable key for it.
TRESTLE_API_URL=http://localhost:9000
TRESTLE_PUBLISHABLE_KEY=
