---
import Checkout from '../../layouts/Checkout.astro';

/**
 * 3e: the order is still being placed, by another tap or tab, or by this one past the server's
 * retry deadline. The page reloads itself every 2 s (no JavaScript needed) and checks the cart:
 * once it is placed, the middleware swaps it for the order and this page sends the shopper to
 * the confirmation. After a minute the message changes but polling goes on (ADR 0018).
 */
const LONG_WAIT_MS = 60_000;

const { cart } = Astro.locals;
if (!cart) return Astro.redirect('/checkout/confirmation');
if (cart.checkoutState !== 'completing') {
  // The attempt ended without an order (e.g. it was declined): back to review to see why.
  return Astro.redirect(cart.lines.length > 0 ? '/checkout/review?error=not_placed' : '/cart');
}

const since = Number(Astro.url.searchParams.get('since')) || Date.now();
const long = Date.now() - since > LONG_WAIT_MS;
---

<Checkout title="Placing your order" locked refreshTo={`/checkout/placing?since=${since}`}>
  <div class="placing" role="status" aria-busy="true">
    <div class="spinner" aria-hidden="true"></div>
    {
      long ? (
        <>
          <h1>We’re confirming your order</h1>
          <p>This is taking longer than usual. Keep this page open and we’ll show your confirmation as soon as it’s done.</p>
        </>
      ) : (
        <>
          <h1>Your order is already being placed</h1>
          <p>It was started from another tap or tab. Stay on this page and we’ll show your confirmation as soon as it’s done.</p>
        </>
      )
    }
    <button type="button" class="button" disabled>Placing order…</button>
  </div>
</Checkout>

<style>
  .placing {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: 32rem;
    margin: var(--space-8) auto;
    text-align: center;
  }

  h1 {
    font-size: 1.5rem;
    font-weight: 500;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }

  .button {
    align-self: stretch;
  }

  .spinner {
    width: 3rem;
    height: 3rem;
    border: 4px solid var(--color-border);
    border-top-color: var(--color-fg);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spinner {
      animation: none;
    }
  }
</style>
