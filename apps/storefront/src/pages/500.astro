---
import '../styles/global.css';

// Rendered when a page throws, including when the Store API is unreachable, so it uses no data
// from the middleware.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Something went wrong</title>
  </head>
  <body>
    <main class="container">
      <h1>Something went wrong</h1>
      <p>The shop could not load this page. Please try again in a moment.</p>
      <a class="button" href="/">Try the home page</a>
    </main>
  </body>
</html>

<style>
  main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: var(--space-12);
  }

  p {
    margin: 0;
  }
</style>
