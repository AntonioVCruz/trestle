---
import CartMessage from '../components/CartMessage.astro';
import CheckoutButton from '../components/CheckoutButton.astro';
import EmptyCart from '../components/EmptyCart.astro';
import LineAmount from '../components/LineAmount.astro';
import LineControls from '../components/LineControls.astro';
import UnavailableNotice from '../components/UnavailableNotice.astro';
import Base from '../layouts/Base.astro';
import { lineTitle } from '../lib/cart.js';
import { formatMoney } from '../lib/money.js';

/**
 * The cart page (1n, 1o, 1p, 3b). Its forms post and reload the page; the drawer script leaves
 * them alone here. Totals are the cart's own: the storefront never adds prices up. The discount
 * code and tax rows are planned.
 */
const { cart, locale } = Astro.locals;
const format = (amount: number) => formatMoney(amount, cart!.currency, locale);
const returnTo = '/cart';
---

<Base title="Cart">
  <div class="container page">
    <h1>Cart</h1>
    <CartMessage params={Astro.url.searchParams} />

    {
      !cart || cart.lines.length === 0 ? (
        <div class="empty">
          <EmptyCart />
        </div>
      ) : (
        <div class="layout">
          <div class="lines-column">
            <UnavailableNotice />
            <table class="lines" role="table">
              <caption class="visually-hidden">Items in your cart</caption>
              <thead role="rowgroup">
                <tr role="row">
                  <th role="columnheader" scope="col">Product</th>
                  <th role="columnheader" scope="col" class="price-col">
                    Price
                  </th>
                  <th role="columnheader" scope="col">Quantity</th>
                  <th role="columnheader" scope="col" class="total-col">
                    Total
                  </th>
                </tr>
              </thead>
              <tbody role="rowgroup">
                {cart.lines.map((line) => (
                  <tr role="row" class:list={{ unavailable: !line.available }}>
                    <td role="cell" class="product">
                      <div class="product-inner">
                        <div class="placeholder-image thumb" aria-hidden="true" />
                        <div>
                          <a href={`/products/${line.productHandle}`}>{lineTitle(line)}</a>
                          {line.sku && <p class="sku">SKU {line.sku}</p>}
                          {line.available ? (
                            <p class="each">
                              <LineAmount line={line} show="unit" each />
                            </p>
                          ) : (
                            <p class="gone">No longer available</p>
                          )}
                        </div>
                      </div>
                    </td>
                    <td role="cell" class="price-col">{line.available && <LineAmount line={line} show="unit" />}</td>
                    <td role="cell" class="quantity">
                      <LineControls line={line} returnTo={returnTo} />
                    </td>
                    <td role="cell" class="total-col">{line.available && <LineAmount line={line} show="total" />}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <section class="summary" aria-labelledby="summary-title">
            <h2 id="summary-title">Order summary</h2>
            <dl>
              <div>
                <dt>Subtotal</dt>
                <dd>{format(cart.subtotal)}</dd>
              </div>
              {cart.adjustments
                .filter((a) => !a.included)
                .map((a) => (
                  <div>
                    <dt>{a.label}</dt>
                    <dd>{format(a.amount)}</dd>
                  </div>
                ))}
              {!cart.shippingMethod && (
                <div>
                  <dt>Shipping</dt>
                  <dd class="muted">at next step</dd>
                </div>
              )}
              <div class="total">
                <dt>Total</dt>
                <dd>
                  {format(cart.total)} {cart.currency}
                </dd>
              </div>
            </dl>
            <CheckoutButton />
            <a href="/products" class="continue">
              Continue shopping
            </a>
          </section>
        </div>
      )
    }
  </div>
</Base>

<style>
  .page {
    padding-block: var(--space-6);
  }

  h1 {
    font-size: 2rem;
    font-weight: 500;
    margin-bottom: var(--space-4);
  }

  .empty {
    max-width: 32rem;
    margin-top: var(--space-4);
  }

  .layout {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-4);
  }

  .lines-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .lines {
    width: 100%;
    border-collapse: collapse;
  }

  /* A stacked list on small screens, a table on wide ones (1n, 1o). */
  .lines thead,
  .lines .price-col {
    display: none;
  }

  .lines tr {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .lines td {
    display: block;
    padding: 0;
  }

  .lines .product {
    grid-column: 1 / -1;
  }

  .product-inner {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--space-3);
  }

  .quantity {
    padding-left: calc(5.5rem + var(--space-3)) !important;
  }

  .total-col {
    align-self: center;
    text-align: right;
  }

  @media (min-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 24rem;
      align-items: start;
    }

    .lines thead {
      display: table-header-group;
    }

    .lines .price-col {
      display: table-cell;
    }

    .product-inner {
      grid-template-columns: 5rem 1fr;
      align-items: center;
    }

    .lines tr {
      display: table-row;
    }

    .lines td,
    .lines th {
      display: table-cell;
      padding: var(--space-4) var(--space-3);
      vertical-align: middle;
      text-align: left;
      font-weight: 400;
    }

    .lines th {
      font-size: 0.875rem;
      border-bottom: 1px solid var(--color-fg);
    }

    .lines td {
      border-bottom: 1px solid var(--color-border);
    }

    .lines .total-col {
      text-align: right;
    }

    .quantity {
      padding-left: var(--space-3) !important;
    }

    .each {
      display: none;
    }

    .summary {
      position: sticky;
      top: var(--space-4);
    }
  }

  .thumb {
    aspect-ratio: 4 / 5;
  }

  .product a {
    text-decoration: none;
  }

  .product p {
    margin: var(--space-1) 0 0;
    font-size: 0.875rem;
  }

  .sku {
    color: var(--color-muted);
  }

  .unavailable .product a {
    color: var(--color-muted);
  }

  .gone {
    font-weight: 600;
  }

  .summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-fg);
    border-radius: var(--radius);
  }

  .summary h2 {
    font-size: 1.25rem;
    font-weight: 500;
  }

  dl {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
  }

  dl div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }

  dd {
    margin: 0;
  }

  .muted {
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .total {
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .continue {
    align-self: center;
  }
</style>
