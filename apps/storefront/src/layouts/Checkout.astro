---
import CheckoutSteps from '../components/checkout/CheckoutSteps.astro';
import OrderSummary from '../components/checkout/OrderSummary.astro';
import type { PriceChange, Step } from '../lib/checkout.js';
import { formatMoney } from '../lib/money.js';
import '../styles/global.css';
import '../styles/checkout.css';

/**
 * The checkout shell (1r–1w): a quiet header with the way back to the cart, the progress list,
 * and the order summary (collapsed on small screens, beside the form on wide ones). No store
 * navigation or footer, so nothing pulls the shopper away mid-checkout.
 */
interface Props {
  readonly title: string;
  /** The step being shown; none on screens between steps (3c, 3e). */
  readonly step?: Step;
  readonly attention?: readonly Step[];
  readonly changes?: readonly PriceChange[];
  /** Hide the way back to the cart, e.g. while the order is being placed (1v, 3e). */
  readonly locked?: boolean;
  /** For 3e: reload to check on the order. */
  readonly refreshTo?: string;
}

const { title, step, attention, changes, locked = false, refreshTo } = Astro.props;
const { channel, cart, locale } = Astro.locals;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {refreshTo && <meta http-equiv="refresh" content={`2; url=${refreshTo}`} />}
    <title>{title} · {channel.name}</title>
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to content</a>
    <header class="checkout-header">
      <div class="container bar">
        {
          locked ? (
            <span class="back muted" aria-hidden="true">
              ‹ Cart
            </span>
          ) : (
            <a href="/cart" class="back">
              ‹ <span class="long">Back to cart</span>
              <span class="short">Cart</span>
            </a>
          )
        }
        <span class="brand">{channel.name}</span>
        <span class="secure"><span class="long">Secure checkout</span><span class="short">Secure</span></span>
      </div>
    </header>
    {step && <CheckoutSteps current={step} attention={attention} />}

    {
      cart && step && (
        <details class="mobile-summary">
          <summary>
            <span>Show order summary</span>
            <strong>{formatMoney(cart.total, cart.currency, locale)}</strong>
          </summary>
          <div class="container">
            <OrderSummary changes={changes} />
          </div>
        </details>
      )
    }

    <div class:list={['container', 'checkout', { 'with-summary': cart && step }]}>
      <main id="content" tabindex="-1">
        <slot />
      </main>
      {
        cart && step && (
          <aside class="desktop-summary" aria-labelledby="summary-title">
            <h2 id="summary-title">Order summary</h2>
            <OrderSummary changes={changes} />
            <slot name="summary-action" />
          </aside>
        )
      }
    </div>

    <script>
      // An error summary or banner takes focus so it is read first (1r, 1w).
      document.querySelector<HTMLElement>('[data-focus-on-load]')?.focus();
    </script>
  </body>
</html>

<style>
  .checkout-header {
    border-bottom: 1px solid var(--color-fg);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 4rem;
  }

  .back {
    justify-self: start;
    font-size: 0.9375rem;
  }

  .muted {
    color: var(--color-border);
  }

  .long {
    display: none;
  }

  @media (min-width: 900px) {
    .long {
      display: inline;
    }

    .short {
      display: none;
    }
  }

  .brand {
    font-size: 1.125rem;
    font-weight: 500;
    text-transform: uppercase;
  }

  .secure {
    justify-self: end;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .mobile-summary {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-summary summary {
    display: flex;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    list-style: none;
  }

  .mobile-summary summary::-webkit-details-marker {
    display: none;
  }

  .mobile-summary summary span::after {
    content: ' ▾';
    font-size: 0.75em;
  }

  .mobile-summary[open] summary span::after {
    content: ' ▴';
  }

  .mobile-summary .container {
    padding-bottom: var(--space-4);
  }

  .checkout {
    padding-block: var(--space-6) var(--space-12);
  }

  main {
    min-width: 0;
  }

  .desktop-summary {
    display: none;
  }

  @media (min-width: 900px) {
    .mobile-summary {
      display: none;
    }

    .with-summary {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 24rem;
      gap: var(--space-12);
      align-items: start;
    }

    .desktop-summary {
      position: sticky;
      top: var(--space-4);
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--space-6);
      border: 1px solid var(--color-fg);
      border-radius: var(--radius);
    }

    .desktop-summary h2 {
      font-size: 1.25rem;
      font-weight: 500;
    }
  }
</style>
