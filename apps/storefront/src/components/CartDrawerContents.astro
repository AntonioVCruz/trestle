---
import { lineTitle } from '../lib/cart.js';
import { formatMoney } from '../lib/money.js';
import CartMessage from './CartMessage.astro';
import CheckoutButton from './CheckoutButton.astro';
import EmptyCart from './EmptyCart.astro';
import LineAmount from './LineAmount.astro';
import LineControls from './LineControls.astro';
import UnavailableNotice from './UnavailableNotice.astro';

/**
 * What the cart drawer shows (1m). Rendered with each page, and again by /fragments/cart after a
 * change, which the drawer script swaps in.
 */
interface Props {
  /** The query parameters of the last cart change (added, removed, error). */
  readonly params: URLSearchParams;
}

const { params } = Astro.props;
const { cart, locale } = Astro.locals;
const count = cart?.itemCount ?? 0;
// After a change, the forms post back to the fragment.
const returnTo = '/fragments/cart';
---

<div class="contents" data-cart-fragment data-cart-count={count}>
  <div class="head">
    <h2 id="cart-drawer-title">Your cart ({count})</h2>
    <button type="button" class="close" aria-label="Close cart" data-cart-close>✕</button>
  </div>
  <CartMessage params={params} />

  {
    !cart || cart.lines.length === 0 ? (
      <div class="body">
        <EmptyCart />
      </div>
    ) : (
      <>
        <div class="body">
          <UnavailableNotice />
          <ul role="list" class="lines">
            {cart.lines.map((line) => (
              <li class:list={{ unavailable: !line.available }}>
                <div class="placeholder-image thumb" aria-hidden="true" />
                <div class="info">
                  <a href={`/products/${line.productHandle}`}>{lineTitle(line)}</a>
                  {!line.available && <p class="gone">No longer available</p>}
                  <LineControls line={line} returnTo={returnTo} enhanced />
                </div>
                {line.available && <LineAmount line={line} show="total" />}
              </li>
            ))}
          </ul>
        </div>
        <div class="foot">
          <p class="subtotal">
            <span>Subtotal</span>
            <span>{formatMoney(cart.subtotal, cart.currency, locale)}</span>
          </p>
          <p class="note">Shipping, discounts and tax calculated at checkout.</p>
          <CheckoutButton />
          <a class="button button-secondary" href="/cart">
            View cart
          </a>
        </div>
      </>
    )
  }
</div>

<style>
  .contents {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-fg);
  }

  h2 {
    font-size: 1.25rem;
    font-weight: 500;
  }

  .close {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: none;
    font: inherit;
    cursor: pointer;
  }

  .body {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  .lines {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lines li {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    gap: var(--space-3);
    align-items: start;
  }

  .thumb {
    aspect-ratio: 4 / 5;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .info a {
    text-decoration: none;
  }

  .unavailable .info a {
    color: var(--color-muted);
  }

  .gone {
    margin: 0;
    font-weight: 600;
  }

  .foot {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    border-top: 1px solid var(--color-fg);
  }

  .foot p {
    margin: 0;
  }

  .subtotal {
    display: flex;
    justify-content: space-between;
    font-size: 1.125rem;
  }

  .note {
    font-size: 0.875rem;
    color: var(--color-muted);
  }
</style>
