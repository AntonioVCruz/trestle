---
// The empty cart (1p), on the cart page and in the drawer.
---

<div class="empty">
  <h2>Your cart is empty</h2>
  <p>Items you add will show up here.</p>
  <a class="button" href="/products">Start shopping</a>
</div>

<style>
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-6);
    border: 1px dashed var(--color-muted);
    border-radius: var(--radius);
    text-align: center;
  }

  h2 {
    font-size: 1.25rem;
    font-weight: 500;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }

  .button {
    align-self: stretch;
  }
</style>
