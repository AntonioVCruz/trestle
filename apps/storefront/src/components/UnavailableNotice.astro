---
import { unavailableLines } from '../lib/cart.js';

// Lines that can no longer be bought block checkout until removed (3b).
const { cart } = Astro.locals;
const count = cart ? unavailableLines(cart).length : 0;
---

{
  count > 0 && (
    <div class="notice" role="alert">
      <p class="title">
        ⚠ {count === 1 ? '1 item is' : `${count} items are`} no longer available
      </p>
      <p>Remove {count === 1 ? 'it' : 'them'} to continue to checkout.</p>
    </div>
  )
}

<style>
  .notice {
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--color-fg);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  p {
    margin: 0;
  }

  .title {
    font-weight: 600;
  }
</style>
